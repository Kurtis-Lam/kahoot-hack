{
  "manifest_version": 3,
  "name": "Kahoot Hack",
  "version": "2.1.0",
  "description": "Automatically answers Kahoot! questions using DeepSeek AI. No sign-in, no limits.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "https://openrouter.ai/*",
    "https://*.kahoot.it/*",
    "https://*.kahoot.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.kahoot.it/*",
        "https://kahoot.it/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["scripts/injected.js", "kahoothack_logo.png"],
      "matches": ["https://*.kahoot.it/*", "https://kahoot.it/*"]
    }
  ]
}